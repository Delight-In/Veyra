# ==========================================
# EduNova / Veyra Production .gitignore
# Prevents sensitive files & secrets from being pushed to GitHub
# ==========================================

# 1. Environment & Secret Variables (CRITICAL)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
*.env

# 2. Dependencies
node_modules/
/.pnp
.pnp.js

# 3. Production & Build Outputs
dist/
dist-ssr/
build/
out/
*.local

# 4. Vite & Bundler Cache
.vite/
.vite-temp/
.turbo/
.cache/
.parcel-cache/
.eslintcache

# 5. Logs & Runtime Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# 6. Database & Persistent Local Storage
*.sqlite
*.sqlite3
*.db
mongodb-data/
*.rdb

# 7. User Media Uploads (Keep folder, ignore uploaded files)
public/uploads/*
!public/uploads/.gitkeep

# 8. Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 9. IDE & Editor Directories
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 10. Temporary & Backup Files
*.bak
*.tmp
*.temp
scratch/
.system_generated/
