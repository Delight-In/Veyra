# =================================================================
# EduNova Platform - Environment Configuration Template
# COPY THIS FILE TO `.env` BEFORE RUNNING THE APPLICATION
# NOTE: DO NOT COMMIT YOUR REAL `.env` WITH ACTUAL SECRETS TO GITHUB!
# =================================================================

# -----------------------------------------------------------------
# 1. Server & Runtime Settings
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------
# 2. Database Connection (MongoDB)
# -----------------------------------------------------------------
# Local MongoDB: mongodb://localhost:27017/edunova
# Cloud MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/edunova?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/edunova

# -----------------------------------------------------------------
# 3. Security & Authentication (JWT)
# -----------------------------------------------------------------
# In production, generate a strong random 256-bit key (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_characters
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------
# 4. Email Verification & Password Reset (SMTP)
# -----------------------------------------------------------------
# Leave empty in local development: the server will automatically log OTPs
# and verification preview links directly into the terminal console.
# In production, provide your actual SMTP credentials (e.g., SendGrid, Mailgun, AWS SES, Gmail App Password)
EMAIL_FROM=EduNova Academy <verify@edunova.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# -----------------------------------------------------------------
# 5. Default Super Administrator Credentials (Seed)
# -----------------------------------------------------------------
# Used only during initial database bootstrap if no super admin exists
DEFAULT_ADMIN_EMAIL=p@veyra.com
DEFAULT_ADMIN_PASSWORD=change_this_admin_password_123

# -----------------------------------------------------------------
# 6. Frontend / Client Variables (Vite)
# -----------------------------------------------------------------
VITE_API_URL=http://localhost:5000
